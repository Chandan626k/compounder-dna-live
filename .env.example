# Server-side secrets only. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGIN=

# NSE/BSE production integration placeholders.
# Store credential VALUES only in the deployment secret manager/environment.
# These variables are REFERENCES/metadata consumed by the provider transport.
NSE_ENDPOINT=
NSE_AUTHENTICATION_MODE=
NSE_CREDENTIAL_REFERENCE=
NSE_REQUEST_TIMEOUT_MS=5000
NSE_RETRY_MAX_ATTEMPTS=1
NSE_RETRY_BASE_DELAY_MS=0
NSE_RETRY_MAX_DELAY_MS=0
NSE_RETENTION_POLICY=EXTERNAL
NSE_HISTORICAL_ACCESS=false
NSE_ENVIRONMENT=disabled

BSE_ENDPOINT=
BSE_AUTHENTICATION_MODE=
BSE_CREDENTIAL_REFERENCE=
BSE_REQUEST_TIMEOUT_MS=5000
BSE_RETRY_MAX_ATTEMPTS=1
BSE_RETRY_BASE_DELAY_MS=0
BSE_RETRY_MAX_DELAY_MS=0
BSE_RETENTION_POLICY=EXTERNAL
BSE_HISTORICAL_ACCESS=false
BSE_ENVIRONMENT=disabled
